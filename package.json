{
  "name": "clan-ledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-web.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare-web.mjs",
    "build": "vite build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply clan-ledger-db --local",
    "db:remote": "wrangler d1 migrations apply clan-ledger-db --remote",
    "test": "node --test tests/*.test.js",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.2.0",
    "wrangler": "^4.0.0"
  }
}
